MOVE_ETL_DATABASE_URL=postgresql+psycopg2://move:move@localhost:5432/move_intelligence

# O próprio ETL chama o MCP Bright Data. Em desenvolvimento local, a conexão
# `bright_data` já registrada no Codex é descoberta sem copiar o token.
BRIGHTDATA_PROVIDER=mcp
BRIGHTDATA_TRENDS_TIMEOUT=180
BRIGHTDATA_MCP_NAME=bright_data
BRIGHTDATA_MCP_DISCOVER_CODEX=true

# Em servidor/produção, injete a URL autenticada como segredo e desative a
# descoberta local. Nunca exponha esta URL no frontend ou em logs.
BRIGHTDATA_MCP_URL=

# Teto de chamadas pagas da descoberta por execução, contando busca +
# raspagens (A3.5). A primeira execução (backfill, sem rodízio) também
# respeita o teto. Default 300.
DISCOVERY_MAX_CALLS=300

# Teto de chamadas do acompanhamento por execução (F1.3). Default 50.
TRACK_LISTINGS_MAX_CALLS=50

# Termo âncora enviado na MESMA requisição do Google Trends (A3.8): torna
# execuções comparáveis sem reescalar o histórico. A série da âncora é
# persistida junto (mesmo request_id).
TRENDS_ANCHOR_KEYWORD=

# Radar semanal do Subprojeto C. Desativado por padrão para não chamar
# Bright Data sem habilitação explícita; teto padrão: 200 termos/ciclo.
SEARCH_TRENDS_ENABLED=false
TRENDS_MAX_REQUESTS_PER_RUN=200
