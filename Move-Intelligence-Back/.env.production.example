POSTGRES_USER=move
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=move_intelligence
NODE_ENV=production
DATABASE_URL=postgresql://move:replace-with-a-strong-password@postgres:5432/move_intelligence?schema=public
MOVE_ETL_DATABASE_URL=postgresql+psycopg2://move:replace-with-a-strong-password@postgres:5432/move_intelligence
REDIS_URL=redis://:replace-with-redis-password@redis:6379/0?family=0
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=https://move-all.pages.dev
IMPORTS_STORAGE_DIR=/data/imports
IMPORTS_USE_QUEUE=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=https://move-all.pages.dev
OPENROUTER_X_TITLE=Move Intelligence
BRIGHTDATA_PROVIDER=mcp
BRIGHTDATA_MCP_URL=
BRIGHTDATA_MCP_MAX_CONCURRENCY=8
WEEKLY_COLLECTION_CRON_ENABLED=true
WEEKLY_COLLECTION_CRON=0 3 * * 1
NVIDIA_API_KEY=
NVIDIA_API_URL=
NVIDIA_MODEL=
APIFY_TOKEN=
GOOGLE_TRENDS_PROVIDER_URL=
GOOGLE_SHOPPING_PROVIDER_URL=
AMAZON_PROVIDER_URL=
XIAOHONGSHU_PROVIDER_URL=
DOUYIN_PROVIDER_URL=
