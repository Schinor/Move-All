NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://move:move@localhost:5432/move_intelligence?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=
CORS_ORIGINS=http://localhost:4200
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=http://localhost:4200
OPENROUTER_X_TITLE=Move Intelligence
WEEKLY_COLLECTION_CRON_ENABLED=false
WEEKLY_COLLECTION_CRON=0 3 * * 1
# Acompanhamento diário de anúncios (F1.5): o job filtra o que venceu por
# next_due_at. Mesmo padrão da coleta semanal (ligado em produção por padrão).
TRACK_LISTINGS_CRON_ENABLED=false
TRACK_LISTINGS_CRON=0 2 * * *
# Teto de raspagens por execução do acompanhamento (orçamento D1 pendente).
TRACK_LISTINGS_MAX_CALLS=50
# Câmbio diário PTAX (F1.7, fonte D5 pendente): popula exchange_rates.
EXCHANGE_RATES_CRON_ENABLED=false
EXCHANGE_RATES_CRON=30 1 * * *
# Quando false (default), exclui do ranking/dashboard, Monte Carlo em lote,
# alertas e copilot os produtos/snapshots marcados is_synthetic=true (gerados
# pelo pipeline historical-collection/seed-6months). Só ligue em ambiente de
# demonstração — nunca em produção com dados reais.
INCLUDE_SYNTHETIC_DATA=false
# Para o comando npm run collect:week quando a API estiver protegida:
MOVE_API_TOKEN=
MOVE_API_EMAIL=
MOVE_API_PASSWORD=
# Quando false, POST /auth/register responde 403 (default true: registro aberto).
# Em produção, considere fechar o registro após criar as contas iniciais.
AUTH_ALLOW_REGISTRATION=true

# ALIEXPRESS_API_KEY=
# APIFY_TOKEN=
# GOOGLE_TRENDS_PROVIDER_URL=
# GOOGLE_SHOPPING_PROVIDER_URL=
# AMAZON_PROVIDER_URL=
# XIAOHONGSHU_PROVIDER_URL=
# DOUYIN_PROVIDER_URL=

# Runtime do ETL v2 (o diretório é inferido quando os três projetos são irmãos).
PYTHON_BIN=python3
MOVE_INTELLIGENCE_DATA_DIR=

# O ETL usa MCP diretamente. Localmente ele pode descobrir a conexão
# `bright_data` do Codex; em produção, BRIGHTDATA_MCP_URL deve ser um segredo.
BRIGHTDATA_PROVIDER=mcp
BRIGHTDATA_MCP_NAME=bright_data
BRIGHTDATA_MCP_DISCOVER_CODEX=true
BRIGHTDATA_MCP_URL=
BRIGHTDATA_MCP_MAX_CONCURRENCY=8

# Catálogo (subprojeto A) — ficha por anúncio gerada pela LLM do OpenRouter.
# O plano gratuito do OpenRouter tem 50 chamadas/dia PARA A CONTA INTEIRA (zera 00:00 UTC);
# FICHA_DAILY_CALL_LIMIT é o teto de chamadas do dia (todos os endpoints) até o qual as fichas rodam.
FICHA_ENABLED=false
FICHA_CRON=*/30 * * * *
FICHA_DAILY_CALL_LIMIT=35
FICHA_BATCH_SIZE=20
FICHA_MAX_TOKENS=20000
FICHA_TIMEOUT_MS=120000
# Vazio = usa OPENROUTER_MODEL
FICHA_MODEL=

# Atribuição automática de anúncios sem chamada LLM; use false para manter tudo na revisão.
CATALOG_AUTO_ASSIGN_ENABLED=true
CATALOG_AUTO_MIN_SIMILARITY=0.35
CATALOG_AUTO_MIN_MARGIN=0.10
CATALOG_AUTO_DIFF_MIN_LISTINGS=3
CATALOG_AUTO_DIFF_MIN_MARKETPLACES=2
CATALOG_AUTO_MAX_REQUEUES=2

# Subprojeto D — descoberta pelos termos em alta (busca só com FICHA_ENABLED=true também)
RADAR_DISCOVERY_ENABLED=false
RADAR_DISCOVERY_MAX_TERMS=5
RADAR_DISCOVERY_LIMIT_PER_SOURCE=10
DISCOVERY_TERMS_CRON=0 6 * * *
# Subprojeto D — níveis de acompanhamento (vagas)
TRACK_TOP_CARDS=50
TRACK_TIER1_SLOTS=80
TRACK_TIER2_SLOTS=100
TRACK_RADAR_MIN_GROWTH=0.20
TRACK_DISCOVERY_WINDOW_DAYS=30

# Plano de coleta real e desempenho
SEARCH_TRENDS_CRON_ENABLED=false
SEARCH_TRENDS_CRON=0 20 * * 0
CARD_ROLLUPS_CRON=*/30 * * * *
CARD_ROLLUPS_MAX_AGE_SECONDS=3600
