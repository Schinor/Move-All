NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://move:move@localhost:5432/move_intelligence?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=
CORS_ORIGINS=http://localhost:4200
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3"
WEEKLY_COLLECTION_CRON_ENABLED=false
WEEKLY_COLLECTION_CRON=0 3 * * 1
# Para o comando npm run collect:week quando a API estiver protegida:
MOVE_API_TOKEN=
MOVE_API_EMAIL=
MOVE_API_PASSWORD=

# ALIEXPRESS_API_KEY=
# APIFY_TOKEN=
# GOOGLE_TRENDS_PROVIDER_URL=
# GOOGLE_SHOPPING_PROVIDER_URL=
# AMAZON_PROVIDER_URL=
# XIAOHONGSHU_PROVIDER_URL=
# DOUYIN_PROVIDER_URL=
NVIDIA_API_KEY=

# Runtime do ETL v2 (o diretório é inferido quando os três projetos são irmãos).
PYTHON_BIN=python3
MOVE_INTELLIGENCE_DATA_DIR=

# O ETL usa MCP diretamente. Localmente ele pode descobrir a conexão
# `bright_data` do Codex; em produção, BRIGHTDATA_MCP_URL deve ser um segredo.
BRIGHTDATA_PROVIDER=mcp
BRIGHTDATA_MCP_NAME=bright_data
BRIGHTDATA_MCP_DISCOVER_CODEX=true
BRIGHTDATA_MCP_URL=
BRIGHTDATA_MCP_MAX_CONCURRENCY=8
