{
  "name": "move-intelligence-back",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de coleta e inteligencia de mercado fitness do Move Intelligence.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.prisma\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:sync": "prisma db push",
    "prisma:studio": "prisma studio",
    "catalog:seed": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-seed.ts",
    "catalog:sync-suppliers": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-sync-suppliers.ts",
    "catalog:auto-resolve": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-auto-resolve.ts",
    "catalog:reprocess": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-reprocess.ts",
    "catalog:run-fichas": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-run-fichas.ts",
    "catalog:held": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-held.ts",
    "perf:probe": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/perf-probe.ts",
    "perf:golden": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/perf-golden.ts",
    "catalog:import-fichas": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-import-fichas.ts",
    "catalog:eval": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/catalog-eval.ts",
    "scores:resimulate": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/scores-resimulate.ts",
    "discovery:refresh": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/discovery-refresh.ts",
    "discovery:search": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/discovery-search.ts",
    "tracking:recalc": "node --env-file-if-exists=.env -r ts-node/register -r tsconfig-paths/register scripts/tracking-recalc.ts",
    "user:make-admin": "node --env-file-if-exists=.env -r ts-node/register scripts/user-make-admin.ts",
    "seed:tradeatlas": "node --env-file-if-exists=.env -r ts-node/register scripts/seed-tradeatlas.ts",
    "seed:fitness-6m": "node --env-file-if-exists=.env -r ts-node/register scripts/seed-6months-fitness-dataset.ts",
    "collect:week": "node --env-file-if-exists=.env scripts/start-weekly-collection.mjs",
    "products:cleanup-non-fitness": "node --env-file-if-exists=.env scripts/cleanup-non-fitness.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.34.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.2",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "testEnvironment": "node"
  }
}
