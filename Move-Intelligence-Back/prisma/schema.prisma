generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollectionStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum ImportSourceType {
  COMEX_ANUAL
  COMEX_MENSAL
  TRADE_ATLAS
  TIKTOK_SHOP
  SHEIN
  GOOGLE_SHOPPING
  AMAZON_PRODUCTS
  AMAZON_SELLERS
  ALIBABA
  AUTO
}

enum ImportStatus {
  RECEIVED
  PROCESSING
  DONE
  FAILED
}

model RawApiResponse {
  id            String   @id @default(uuid()) @db.Uuid
  source        String
  endpoint      String
  queryTerm     String?  @map("query_term")
  requestParams Json     @map("request_params")
  responseBody  Json     @map("response_body")
  statusCode    Int      @map("status_code")
  collectedAt   DateTime @default(now()) @map("collected_at")

  @@index([source, collectedAt])
  @@map("raw_api_responses")
}

model ProductListingSnapshot {
  id                String               @id @default(uuid()) @db.Uuid
  marketplace       String
  externalProductId String               @map("external_product_id")
  productClusterId  String?              @map("product_cluster_id") @db.Uuid
  title             String
  priceMin          Decimal?             @map("price_min") @db.Decimal(14, 4)
  priceMax          Decimal?             @map("price_max") @db.Decimal(14, 4)
  currency          String?
  moq               Int?
  stock             Int?
  rating            Decimal?             @db.Decimal(5, 2)
  reviewCount       Int?                 @map("review_count")
  salesSignalRaw    Decimal?             @map("sales_signal_raw") @db.Decimal(14, 4)
  salesSignalType   String?              @map("sales_signal_type")
  sellerId          String?              @map("seller_id")
  sellerName        String?              @map("seller_name")
  imageCount        Int?                 @map("image_count")
  collectedAt       DateTime             @default(now()) @map("collected_at")
  // Origem do snapshot quando veio de uma importação de CSV (Bright Data).
  importJobId       String?              @map("import_job_id") @db.Uuid
  rawProductId      String?              @map("raw_product_id") @db.Uuid
  imageUrl          String?              @map("image_url")
  productUrl        String?              @map("product_url")
  // Marca snapshots gerados pelo pipeline sintético (historical-collection /
  // seed-6months), propagado a partir de IntelligenceProduct.isSynthetic em
  // syncAnalyticalModels. Ver RELATORIO_ANALISE_DADOS_E_SCORES.md seção 2.1 A5.
  isSynthetic       Boolean              @default(false) @map("is_synthetic")
  /// true = fora de score/séries/Monte Carlo/ranking (anúncio provisório de card confirmado).
  analyticsExcluded Boolean              @default(false) @map("analytics_excluded")
  cluster           ProductCluster?      @relation(fields: [productClusterId], references: [id])
  importJob         ImportJob?           @relation(fields: [importJobId], references: [id])
  rawProduct        IntelligenceProduct? @relation(fields: [rawProductId], references: [id])

  @@unique([marketplace, externalProductId, collectedAt], map: "pls_marketplace_extid_collected_at_key")
  @@index([productClusterId, collectedAt])
  @@index([collectedAt])
  @@index([importJobId])
  @@index([rawProductId])
  @@index([isSynthetic])
  @@map("product_listing_snapshots")
}

/// Snapshot normalizado produzido pelo ETL v2. É a fonte canônica para novas
/// coletas Bright Data e mantém os campos nativos em source_specific.
model IntelligenceProduct {
  id                  String                          @id @db.Uuid
  source              String
  recordId            String                          @map("record_id")
  capturedAt          DateTime                        @map("captured_at") @db.Date
  title               String
  canonicalTitle      String?                         @map("canonical_title")
  gtin                String?                         @db.VarChar(14)
  brand               String?
  attrs               Json                            @default("{}")
  cluster             String?
  priceValue          Decimal?                        @map("price_value") @db.Decimal
  priceCurrency       String?                         @map("price_currency")
  rating              Decimal?                        @db.Decimal
  reviewsCount        Int?                            @map("reviews_count")
  monthlySales        Int?                            @map("monthly_sales")
  moq                 Int?
  supplier            String?
  dataQuality         String                          @map("data_quality")
  sourceSpecific      Json                            @default("{}") @map("source_specific")
  // Marca produtos gerados pelo pipeline sintético (historical-collection /
  // seed-6months, supplier "Move Fitness Partner%") em vez de coleta real.
  // Ver RELATORIO_ANALISE_DADOS_E_SCORES.md seção 2.1 A5.
  isSynthetic         Boolean                         @default(false) @map("is_synthetic")
  demandLinks         IntelligenceProductDemandLink[]
  analyticalSnapshots ProductListingSnapshot[]

  @@unique([source, recordId, capturedAt])
  @@index([source, cluster])
  @@index([capturedAt])
  @@index([gtin])
  @@index([isSynthetic])
  @@index([canonicalTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_products_canonical_trgm")
  @@map("products")
}

/// Observação de demanda normalizada pelo ETL v2.
model IntelligenceDemandSignal {
  id           String                          @id @db.Uuid
  keyword      String
  geo          String
  source       String
  weekStart    DateTime                        @map("week_start") @db.Date
  trendIndex   Decimal                         @map("trend_index") @db.Decimal
  rawValue     Decimal?                        @map("raw_value") @db.Decimal
  capturedAt   DateTime                        @map("captured_at") @db.Date
  // Contexto da observação (F1.6): âncora/timeframe/request que tornam
  // execuções comparáveis sem reescrever o histórico.
  requestId     String?                        @map("request_id")
  timeframe     String?                        @map("timeframe")
  anchorKeyword String?                        @map("anchor_keyword")
  productLinks IntelligenceProductDemandLink[]

  @@unique([keyword, geo, source, weekStart])
  @@index([keyword, geo, source])
  @@index([weekStart])
  @@map("demand_signals")
}

/// Vínculo auditável cluster/keyword produzido pelo ETL v2.
model IntelligenceProductDemandLink {
  id             String                   @id @db.Uuid
  productId      String                   @map("product_id") @db.Uuid
  demandSignalId String                   @map("demand_signal_id") @db.Uuid
  keyword        String
  matchMethod    String                   @map("match_method")
  createdAt      DateTime                 @default(now()) @map("created_at")
  product        IntelligenceProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  demandSignal   IntelligenceDemandSignal @relation(fields: [demandSignalId], references: [id], onDelete: Cascade)

  @@unique([productId, demandSignalId, keyword])
  @@index([productId])
  @@index([demandSignalId])
  @@map("product_demand_link")
}

/// Vendedor de marketplace (ex.: Amazon Sellers Info), importado via CSV.
model MarketplaceSeller {
  id               String     @id @default(uuid()) @db.Uuid
  marketplace      String
  externalSellerId String     @map("external_seller_id")
  name             String?
  businessName     String?    @map("business_name")
  country          String?
  rating           Decimal?   @db.Decimal(5, 2)
  ratingCount      Int?       @map("rating_count")
  positivePct      Decimal?   @map("positive_pct") @db.Decimal(5, 2)
  productsCount    Int?       @map("products_count")
  sellerUrl        String?    @map("seller_url")
  importJobId      String?    @map("import_job_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  importJob        ImportJob? @relation(fields: [importJobId], references: [id])

  @@unique([marketplace, externalSellerId])
  @@index([importJobId])
  @@map("marketplace_sellers")
}

model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @map("base_currency")
  quoteCurrency String   @map("quote_currency")
  rate          Decimal  @db.Decimal(18, 8)
  capturedAt    DateTime @default(now()) @map("captured_at")

  @@unique([baseCurrency, quoteCurrency, capturedAt])
  @@index([baseCurrency, quoteCurrency])
  @@map("exchange_rates")
}

model LogisticsCostParam {
  id                           String    @id @default(uuid()) @db.Uuid
  productCategory              String    @map("product_category")
  route                        String
  domesticFreightEstimate      Decimal?  @map("domestic_freight_estimate") @db.Decimal(14, 4)
  internationalFreightEstimate Decimal?  @map("international_freight_estimate") @db.Decimal(14, 4)
  importTaxRate                Decimal?  @map("import_tax_rate") @db.Decimal(8, 6)
  operationalFeeRate           Decimal?  @map("operational_fee_rate") @db.Decimal(8, 6)
  validFrom                    DateTime  @default(now()) @map("valid_from")
  validTo                      DateTime? @map("valid_to")

  @@index([productCategory, route])
  @@map("logistics_cost_params")
}

model ProductCluster {
  id              String                   @id @default(uuid()) @db.Uuid
  canonicalName   String                   @map("canonical_name")
  category        String?
  confidenceScore Decimal?                 @map("confidence_score") @db.Decimal(5, 4)
  createdAt       DateTime                 @default(now()) @map("created_at")
  // Resultado da última simulação Monte Carlo (usado como risco oficial no ranking).
  riskLevel       String?                  @map("risk_level")
  financialScore  Int?                     @map("financial_score")
  simulatedAt     DateTime?                @map("simulated_at")
  // Catálogo (subprojeto A): o cluster É o card.
  typeId          String?             @map("type_id") @db.Uuid
  cardKey         String?             @map("card_key")
  cardKeyValues   Json?               @map("card_key_values")
  /// legacy | provisional | confirmed | merged
  cardStatus      String              @default("legacy") @map("card_status")
  nameLocked      Boolean             @default(false) @map("name_locked")
  mergedIntoId    String?             @map("merged_into_id") @db.Uuid
  items           ProductClusterItem[]
  snapshots       ProductListingSnapshot[]
  alerts          Alert[]
  scores          ProductScore[]
  offerScores     OfferScore[]
  matchReviews    ProductMatchReview[]
  aiRecommendations AiRecommendation[]
  reviewSummaries ReviewSummary[]
  type            CatalogType?        @relation(fields: [typeId], references: [id])
  mergedInto      ProductCluster?     @relation("ClusterMerge", fields: [mergedIntoId], references: [id])
  mergedFrom      ProductCluster[]    @relation("ClusterMerge")
  reviewItems     CatalogReviewItem[]

  @@index([createdAt])
  @@index([canonicalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_clusters_canonical_trgm")
  @@index([category], map: "idx_clusters_category")
  @@index([cardKey], map: "idx_clusters_card_key")
  @@index([typeId, cardStatus], map: "idx_clusters_type_status")
  @@map("product_clusters")
}

model ProductClusterItem {
  id                String         @id @default(uuid()) @db.Uuid
  clusterId         String         @map("cluster_id") @db.Uuid
  marketplace       String
  externalProductId String         @map("external_product_id")
  similarityScore   Decimal        @map("similarity_score") @db.Decimal(5, 4)
  matchedBy         String         @default("text") @map("matched_by")
  matchedAt         DateTime       @default(now()) @map("matched_at")
  /// provisional | confirmed | auto (itens antigos ficam confirmed)
  status            String         @default("confirmed")
  cluster           ProductCluster @relation(fields: [clusterId], references: [id])

  @@unique([marketplace, externalProductId])
  @@index([clusterId])
  @@map("product_cluster_items")
}

/// Anúncio acompanhado pelo loop de acompanhamento (Fase 1). Uma linha por
/// (source, nativeId); a série histórica mora em `ListingObservation`.
/// Ver RELATORIO_ANALISE_DADOS_E_SCORES.md seção 2.2.
model TrackedListing {
  id                  String               @id @default(uuid()) @db.Uuid
  source              String
  nativeId            String               @map("native_id")
  canonicalUrl        String               @map("canonical_url")
  productId           String?              @map("product_id") @db.Uuid
  status              String               @default("CANDIDATE")
  tier                Int                  @default(3)
  discoveredByTerm    String?              @map("discovered_by_term")
  firstSeenAt         DateTime             @default(now()) @map("first_seen_at")
  lastSeenAt          DateTime?            @map("last_seen_at")
  lastSuccessAt       DateTime?            @map("last_success_at")
  consecutiveFailures Int                  @default(0) @map("consecutive_failures")
  nextDueAt           DateTime             @default(now()) @map("next_due_at")
  observations        ListingObservation[]
  // Contagem de reviews na última amostra de textos (A5): nova amostra só
  // quando crescer ≥ 10 ou ≥ 10% (limiares configuráveis).
  reviewsCountAtSample Int?                @map("reviews_count_at_sample")
  reviewSamples       ReviewSample[]
  // Fornecedor que abastece em alto volume (A6, foco B2B). Null enquanto
  // não houver identificação confiável — nunca canal de venda como fornecedor.
  supplierId          String?               @map("supplier_id") @db.Uuid
  supplier            Supplier?             @relation(fields: [supplierId], references: [id])

  @@unique([source, nativeId])
  @@index([status, nextDueAt])
  @@map("tracked_listings")
}

/// Observação de um anúncio acompanhado. APPEND-ONLY: nenhum código pode
/// fazer `update` nela (há teste que varre o código-fonte).
model ListingObservation {
  id             String         @id @default(uuid()) @db.Uuid
  listingId      String         @map("listing_id") @db.Uuid
  observedAt     DateTime       @default(now()) @map("observed_at")
  price          Decimal?       @db.Decimal(14, 4)
  currency       String?
  rating         Decimal?       @db.Decimal(5, 2)
  reviewsCount   Int?           @map("reviews_count")
  soldCountRaw   String?        @map("sold_count_raw")
  soldCountLower Int?           @map("sold_count_lower")
  bestSellerRank Int?           @map("best_seller_rank")
  inStock        Boolean?       @map("in_stock")
  scrapeStatus   String         @map("scrape_status")
  parserVersion  String         @map("parser_version")
  contentHash    String?        @map("content_hash")
  isSynthetic    Boolean        @default(false) @map("is_synthetic")
  // Distribuição de estrelas 1–5 da página do anúncio (A5, JSON
  // {"1": n1, ..., "5": n5}); null quando a fonte não exibir.
  ratingDistribution Json?      @map("rating_distribution")
  listing        TrackedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, observedAt])
  @@map("listing_observations")
}

/// Amostra de textos de avaliação por anúncio (A5). Só o necessário para o
/// resumo por faixa (B5): estrelas, texto, idioma e ID na fonte. NUNCA o nome
/// de quem avaliou. Amostrada só quando reviews_count cresce ≥ 10 ou ≥ 10%.
model ReviewSample {
  id              String         @id @default(uuid()) @db.Uuid
  listingId       String         @map("listing_id") @db.Uuid
  collectedAt     DateTime       @default(now()) @map("collected_at")
  stars           Int?
  text            String
  sourceReviewId  String?        @map("source_review_id")
  language        String?
  listing         TrackedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, collectedAt])
  @@map("review_samples")
}

/// Fornecedor B2B que abastece em alto volume (A6, decisão 8): Alibaba, 1688
/// e AliExpress, onde dá para negociar direto com o fabricante. Canal de
/// venda (Amazon, Mercado Livre) nunca é fornecedor.
model Supplier {
  id               String           @id @default(uuid()) @db.Uuid
  source           String
  nativeSupplierId String           @map("native_supplier_id")
  name             String
  yearsOnPlatform  Int?             @map("years_on_platform")
  verified         Boolean          @default(false)
  country          String?
  updatedAt        DateTime         @updatedAt @map("updated_at")
  listings         TrackedListing[]

  @@unique([source, nativeSupplierId])
  @@map("suppliers")
}

model ProductMatchReview {  id                 String         @id @default(uuid()) @db.Uuid
  sourceProductId    String         @map("source_product_id") @db.Uuid
  candidateProductId String         @map("candidate_product_id") @db.Uuid
  candidateClusterId String         @map("candidate_cluster_id") @db.Uuid
  similarityScore    Decimal        @map("similarity_score") @db.Decimal(5, 4)
  reason             String
  status             String         @default("PENDING")
  matchedBy          String?        @map("matched_by")
  decisionReason     String?        @map("decision_reason")
  reviewedAt         DateTime?      @map("reviewed_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  candidateCluster   ProductCluster @relation(fields: [candidateClusterId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, candidateProductId])
  @@index([status, createdAt])
  @@index([candidateClusterId])
  @@map("product_match_reviews")
}

/// Score oficial Monte Carlo por cluster (Fase 2, F2.1). Uma linha por
/// cálculo; o vigente é o último por cluster (`computedAt`). Os campos
/// `financialScore`, `riskLevel` e `simulatedAt` de `ProductCluster` ficam
/// como deprecated até F2.7.
model ProductScore {
  id              String         @id @default(uuid()) @db.Uuid
  productClusterId String        @map("product_cluster_id") @db.Uuid
  // Nulo quando não há dados para calcular (historico_curto/sem_custo):
  // produto sem score mostra o rótulo de dataConfidence, sem número.
  score           Int?
  decision        String
  pVplPositivo    Float?         @map("p_vpl_positivo")
  cvar5           Float?
  vplMediano      Float?         @map("vpl_mediano")
  premises        Json
  premisesHash    String         @map("premises_hash")
  dataVersion     String         @map("data_version")
  dataConfidence  String         @map("data_confidence")
  scenarioCount   Int            @map("scenario_count")
  computedAt      DateTime       @default(now()) @map("computed_at")
  cluster         ProductCluster @relation(fields: [productClusterId], references: [id], onDelete: Cascade)
  // B3 (decisões 2-3): ação por quadrante + momentum + faixa. Decision fica
  // como histórico até limpeza futura.
  action              String? @map("action")
  momentumDirection   String? @map("momentum_direction")
  momentumGrowthPct   Float?  @map("momentum_growth_pct")
  momentumConfidence  String? @map("momentum_confidence")
  scoreBand           String? @map("score_band")
  // B4: explicação do risco (texto + drivers JSON [{factor, share}]).
  riskExplanation     String? @map("risk_explanation")
  riskDrivers         Json?   @map("risk_drivers")

  @@index([productClusterId, computedAt])
  @@map("product_scores")
}

model OfferScore {
  id                    String         @id @default(uuid()) @db.Uuid
  productClusterId      String         @map("product_cluster_id") @db.Uuid
  marketplace           String
  externalProductId     String         @map("external_product_id")
  score                 Int?
  state                 String
  unitCostUsd           Decimal?       @map("unit_cost_usd") @db.Decimal(14, 4)
  moq                   Int
  capitalPrimeiroPedido Float?         @map("capital_primeiro_pedido")
  pVplPositivo          Float?         @map("p_vpl_positivo")
  vplMediano            Float?         @map("vpl_mediano")
  cvar5                 Float?
  premises              Json           @default("{}")
  premisesHash          String         @default("") @map("premises_hash")
  dataVersion           String         @map("data_version")
  scenarioCount         Int            @default(0) @map("scenario_count")
  computedAt            DateTime       @default(now()) @map("computed_at")
  cluster               ProductCluster @relation(fields: [productClusterId], references: [id], onDelete: Cascade)

  @@index([productClusterId, marketplace, externalProductId, computedAt], map: "offer_scores_cluster_offer_computed_idx")
  @@map("offer_scores")
}

/// Resumo de avaliações por faixa (B5, decisão 10): 1–2 baixo, 3 neutro,
/// 4–5 alto. Histórico por cluster/faixa; exibe o último. Contagem por faixa
/// vem da distribuição de estrelas — a IA nunca calcula números.
model ReviewSummary {
  id             String         @id @default(uuid()) @db.Uuid
  productClusterId String       @map("product_cluster_id") @db.Uuid
  band           String
  summary        String
  topReasons     Json           @map("top_reasons")
  sampleSize     Int            @map("sample_size")
  reviewsCountAt Int?           @map("reviews_count_at")
  model          String?
  promptVersion  String?        @map("prompt_version")
  createdAt      DateTime       @default(now()) @map("created_at")
  cluster        ProductCluster @relation(fields: [productClusterId], references: [id], onDelete: Cascade)

  @@index([productClusterId, band, createdAt])
  @@map("review_summaries")
}

model Alert {
  id               String          @id @default(uuid()) @db.Uuid
  productClusterId String?         @map("product_cluster_id") @db.Uuid
  alertType        String          @map("alert_type")
  severity         AlertSeverity
  message          String
  evidence         Json
  createdAt        DateTime        @default(now()) @map("created_at")
  status           AlertStatus     @default(OPEN)
  cluster          ProductCluster? @relation(fields: [productClusterId], references: [id])

  @@index([status, createdAt])
  @@index([productClusterId])
  @@map("alerts")
}

model BusinessRuleConfig {
  id        String    @id @default(uuid()) @db.Uuid
  key       String
  scope     String?
  value     Json
  active    Boolean   @default(true)
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([key, scope, active])
  @@map("business_rule_configs")
}

model KeywordTerm {
  id        String   @id @default(uuid()) @db.Uuid
  term      String
  language  String
  category  String?
  priority  Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([term, language, category])
  @@index([active, priority])
  @@map("keyword_terms")
}

model CollectionJob {
  id           String           @id @default(uuid()) @db.Uuid
  source       String?
  queryTerm    String           @map("query_term")
  category     String?
  status       CollectionStatus @default(QUEUED)
  requestedBy  String?          @map("requested_by")
  startedAt    DateTime?        @map("started_at")
  finishedAt   DateTime?        @map("finished_at")
  errorMessage String?          @map("error_message")
  stats        Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("collection_jobs")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  company       String?
  role          String         @default("USER")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  catalogReviewsResolved CatalogReviewItem[] @relation("CatalogReviewResolver")
  catalogDecisions       CatalogDecision[]   @relation("CatalogDecisionActor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model WatchlistItem {
  id               String   @id @default(uuid()) @db.Uuid
  productClusterId String   @map("product_cluster_id") @db.Uuid
  note             String?
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([productClusterId])
  @@map("watchlist_items")
}

model ImportJob {
  id           String                   @id @default(uuid()) @db.Uuid
  filename     String
  originalName String                   @map("original_name")
  mimeType     String                   @map("mime_type")
  sizeBytes    Int                      @map("size_bytes")
  sourceType   ImportSourceType         @default(AUTO) @map("source_type")
  detectedType ImportSourceType?        @map("detected_type")
  status       ImportStatus             @default(RECEIVED)
  rowsTotal    Int                      @default(0) @map("rows_total")
  rowsImported Int                      @default(0) @map("rows_imported")
  rowsRejected Int                      @default(0) @map("rows_rejected")
  errorSummary Json?                    @map("error_summary")
  storagePath  String                   @map("storage_path")
  createdAt    DateTime                 @default(now()) @map("created_at")
  startedAt    DateTime?                @map("started_at")
  finishedAt   DateTime?                @map("finished_at")
  tradeExports TradeExport[]
  shipments    Shipment[]
  listings     ProductListingSnapshot[]
  sellers      MarketplaceSeller[]

  @@index([status, createdAt])
  @@map("import_jobs")
}

model TradeExport {
  id             String    @id @default(uuid()) @db.Uuid
  naturalKey     String    @unique @map("natural_key")
  ncmCode        String    @map("ncm_code")
  ncmDescription String?   @map("ncm_description")
  year           Int
  month          Int?
  country        String
  state          String?
  fobUsd         Decimal   @map("fob_usd") @db.Decimal(18, 2)
  netKg          Decimal   @map("net_kg") @db.Decimal(18, 2)
  importJobId    String    @map("import_job_id") @db.Uuid
  importJob      ImportJob @relation(fields: [importJobId], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([ncmCode, year])
  @@index([country])
  @@index([month, country])
  @@map("trade_exports")
}

model Shipment {
  id                String    @id @default(uuid()) @db.Uuid
  naturalKey        String    @unique @map("natural_key")
  arrivalDate       DateTime? @map("arrival_date")
  importerName      String?   @map("importer_name")
  importerCountry   String?   @map("importer_country")
  exporterName      String?   @map("exporter_name")
  exporterCountry   String?   @map("exporter_country")
  originCountry     String?   @map("origin_country")
  hsCode            String?   @map("hs_code")
  productDetails    String?   @map("product_details")
  fobUsd            Decimal?  @map("fob_usd") @db.Decimal(18, 2)
  cifUsd            Decimal?  @map("cif_usd") @db.Decimal(18, 2)
  grossWeightKg     Decimal?  @map("gross_weight_kg") @db.Decimal(18, 2)
  netWeightKg       Decimal?  @map("net_weight_kg") @db.Decimal(18, 2)
  quantity          Decimal?  @db.Decimal(18, 2)
  quantityUnit      String?   @map("quantity_unit")
  portOfArrival     String?   @map("port_of_arrival")
  portOfDeparture   String?   @map("port_of_departure")
  declarationNumber String?   @map("declaration_number")
  itemNo            Int?      @map("item_no")
  importJobId       String    @map("import_job_id") @db.Uuid
  importJob         ImportJob @relation(fields: [importJobId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([hsCode])
  @@index([importerCountry])
  @@index([declarationNumber])
  @@index([arrivalDate, createdAt])
  @@index([exporterName])
  @@map("shipments")
}

model AiRecommendation {
  id               String         @id @default(uuid()) @db.Uuid
  productClusterId String         @map("product_cluster_id") @db.Uuid
  action           String?
  decision         String?
  rationale        String?
  generatedText    String         @map("generated_text")
  modelVersion     String         @map("model_version")
  promptVersion    String         @map("prompt_version")
  scoreSnapshotId  String?        @map("score_snapshot_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  cluster          ProductCluster @relation(fields: [productClusterId], references: [id], onDelete: Cascade)

  @@index([productClusterId, createdAt])
  @@map("ai_recommendations")
}

model AiConversation {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  clientId  String?     @map("client_id")
  title     String?
  isPinned  Boolean     @default(false) @map("is_pinned")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  messages  AiMessage[]

  @@index([userId, updatedAt])
  @@index([clientId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           String
  content        String
  toolCalls      Json?          @map("tool_calls")
  toolCallId     String?        @map("tool_call_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiCallLog {
  id               String   @id @default(uuid()) @db.Uuid
  endpoint         String
  model            String
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  totalTokens      Int?     @map("total_tokens")
  latencyMs        Int      @map("latency_ms")
  status           String
  error            String?
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([endpoint, status, createdAt])
  @@map("ai_call_logs")
}

/// Catálogo (subprojeto A): famílias (as ~20 categorias antigas + novas).
model CatalogFamily {
  id        String        @id @default(uuid()) @db.Uuid
  key       String        @unique
  namePt    String        @map("name_pt")
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  types     CatalogType[]

  @@map("catalog_families")
}

/// Tipo de produto: define a chave do card (card_key_attrs) e o NCM esperado.
model CatalogType {
  id              String           @id @default(uuid()) @db.Uuid
  familyId        String           @map("family_id") @db.Uuid
  key             String           @unique
  namePt          String           @map("name_pt")
  descriptionEn   String           @map("description_en")
  ncm             String?
  cardKeyAttrs    Json             @default("[]") @map("card_key_attrs")
  comparisonAttrs Json             @default("[]") @map("comparison_attrs")
  variationAttrs  Json             @default("[]") @map("variation_attrs")
  source          String           @default("seed")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  family          CatalogFamily    @relation(fields: [familyId], references: [id])
  clusters        ProductCluster[]

  @@map("catalog_types")
}

/// Ficha do anúncio gerada pela LLM. Uma por (marketplace, external_product_id).
model ListingFicha {
  id                String   @id @default(uuid()) @db.Uuid
  marketplace       String
  externalProductId String   @map("external_product_id")
  title             String
  inputHash         String   @map("input_hash")
  status            String   @default("pending")
  priority          Int      @default(100)
  attempts          Int      @default(0)
  lastError         String?  @map("last_error")
  typeKey           String?  @map("type_key")
  suggestedType     String?  @map("suggested_type")
  inScope           Boolean? @map("in_scope")
  isAccessoryOrPart Boolean? @map("is_accessory_or_part")
  isKitOrBundle     Boolean? @map("is_kit_or_bundle")
  hasVariations     Boolean? @map("has_variations")
  cardKeyValues     Json     @default("{}") @map("card_key_values")
  newDifferential   String?  @map("new_differential")
  missingKeyAttrs   String[] @default([]) @map("missing_key_attrs")
  comparisonValues  Json     @default("{}") @map("comparison_values")
  variationValues   Json     @default("{}") @map("variation_values")
  specs             Json     @default("{}")
  brand             String?
  model             String?
  confidence        Decimal? @db.Decimal(4, 3)
  llmModel          String?  @map("llm_model")
  promptVersion     String?  @map("prompt_version")
  copiedFromFichaId String?  @map("copied_from_ficha_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([marketplace, externalProductId])
  @@index([status, priority(sort: Desc), createdAt])
  @@index([inputHash])
  @@map("listing_fichas")
}

/// Fila de revisão do catálogo (ADMIN).
model CatalogReviewItem {
  id                   String          @id @default(uuid()) @db.Uuid
  kind                 String
  marketplace          String?
  externalProductId    String?         @map("external_product_id")
  suggestedClusterId   String?         @map("suggested_cluster_id") @db.Uuid
  suggestedTypeKey     String?         @map("suggested_type_key")
  suggestedTypeAliases String[]        @default([]) @map("suggested_type_aliases")
  listingCount         Int             @default(0) @map("listing_count")
  reason               String
  status               String          @default("pending")
  resolution           String?
  resolvedBy           String?         @map("resolved_by") @db.Uuid
  resolvedAt           DateTime?       @map("resolved_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  suggestedCluster     ProductCluster? @relation(fields: [suggestedClusterId], references: [id], onDelete: SetNull)
  resolver             User?           @relation("CatalogReviewResolver", fields: [resolvedBy], references: [id])

  @@index([kind, status, createdAt])
  @@index([marketplace, externalProductId])
  @@map("catalog_review_items")
}

/// Subprojeto C: coleta do Google Trends por termo/país. O índice (0–100) é relativo
/// a cada coleta; crescimento é calculado dentro da mesma coleta.
model SearchTrendSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  typeKey       String   @map("type_key")
  term          String
  geo           String
  timeframe     String
  status        String
  error         String?
  points        Json     @default("[]")
  lastValue     Int?     @map("last_value")
  growth4w      Float?   @map("growth_4w")
  growth12w     Float?   @map("growth_12w")
  relatedTop    Json     @default("[]") @map("related_top")
  relatedRising Json     @default("[]") @map("related_rising")
  capturedAt    DateTime @default(now()) @map("captured_at")

  @@index([typeKey, geo, capturedAt], map: "search_trend_snapshots_type_geo_captured_idx")
  @@map("search_trend_snapshots")
}

/// Histórico de decisões da revisão (para desfazer).
model CatalogDecision {
  id                 String   @id @default(uuid()) @db.Uuid
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  action             String
  reviewItemId       String?  @map("review_item_id") @db.Uuid
  before             Json
  after              Json
  undoneByDecisionId String?  @map("undone_by_decision_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  actor              User?    @relation("CatalogDecisionActor", fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@map("catalog_decisions")
}
